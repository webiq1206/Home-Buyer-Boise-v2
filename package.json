{
  "name": "home-buyer-boise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5000",
    "prebuild": "npm run links:build && npm run links:audit",
    "build": "next build",
    "start": "next start --port 5000",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "links:build": "npx tsx scripts/internal-links.ts",
