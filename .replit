run = "npm run dev"
entrypoint = "app/page.tsx"
modules = ["nodejs-20:v8-20230920-bd784b9"]

hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "cloudrun"
build = ["bash", "build.sh"]

[[ports]]
localPort = 5000
externalPort = 80
